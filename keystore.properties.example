# Bu dosyayı kopyalayıp adını "keystore.properties" yap (bu klasörün içinde,
# .example'sız), aşağıdaki 4 satırı Android Studio'da oluşturduğun keystore'un
# gerçek bilgileriyle doldur. "keystore.properties" (example'sız olan) ASLA
# başka biriyle paylaşılmamalı, e-postayla gönderilmemeli, buluta
# yüklenmemeli - içinde imzalama şifrelerin var.
#
# storeFile: .jks dosyanın bu klasöre (proje kökü) göre yolu ya da tam yolu.
#   Örnek: paydos-release-key.jks (dosyayı proje kökünde tuttuysan)
storeFile=paydos-release-key.jks
storePassword=BURAYA_KEYSTORE_SIFRESI
keyAlias=paydos
keyPassword=BURAYA_ALIAS_SIFRESI
