<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand -->
    <string name="app_name">Paydos</string>
    <string name="app_title_header">⏳ Paydos</string>

    <!-- Accessibility service description (shown in Android Settings) -->
    <string name="accessibility_service_description">セッション中にどのアプリが画面に表示されているかを Paydos が確認し、許可されていないアプリが開かれたときに元の画面へ戻せるようにします。画面の内容は読み取りません。</string>

    <!-- Main screen -->
    <string name="subtitle_main">時間を選び、許可するアプリを決めて、お子さまにスマホを渡しましょう。</string>

    <string name="permissions_card_title">🔐  最初にいくつかの権限が必要です</string>
    <string name="permissions_card_body">下のボタンを一度タップするだけで大丈夫です。残りは順番に開きますので、各画面で「許可」または「オン」をタップしてください。</string>
    <string name="btn_grant_permissions">権限を設定する</string>

    <string name="pin_title_new">🔑  保護者用PINを設定</string>
    <string name="pin_title_saved">🔑  保護者用PIN（保存済み）</string>
    <string name="pin_hint_new">4桁のPIN</string>
    <string name="pin_hint_change">変更するには新しいPINを入力</string>
    <string name="pin_card_body">時間になる前にロックを解除するには、このPINが必要です。お子さまが知らない番号にしてください。</string>
    <string name="recovery_answer_label">復旧用の答え（必須）</string>
    <string name="recovery_answer_hint">PINを忘れたときは、この答えでロックを解除できます。自分には覚えやすく、お子さまが知らない・推測できないものを選んでください（お子さまの生まれ年や名前は避けましょう）。例：初めて飼ったペットの名前、好きだった先生の名字、高校を卒業した街。</string>
    <string name="recovery_answer_field_hint">復旧用の答え</string>
    <string name="recovery_answer_label_saved">復旧用の答え（保存済み）</string>
    <string name="recovery_answer_field_hint_saved">変更する場合は新しい答えを入力（任意）</string>
    <string name="forgot_pin_link">PINをお忘れですか？</string>
    <string name="recovery_dialog_title">復旧用の答えを入力</string>
    <string name="recovery_dialog_positive">確認</string>
    <string name="recovery_dialog_negative">キャンセル</string>
    <string name="recovery_wrong_answer">答えが違います。もう一度お試しください</string>
    <string name="recovery_not_set">このロックには復旧用の答えが設定されていません</string>
    <string name="toast_recovery_answer_required">PINを忘れても解除できるよう、復旧用の答えも設定してください</string>
    <string name="recovery_restart_hint">PINも復旧用の答えも忘れてしまいましたか？スマホの電源を切って入れ直すと、ロックが解除されます。</string>
    <string name="recovery_question_label">復旧用の質問</string>
    <string-array name="recovery_questions">
        <item>初めて飼ったペットの名前は？</item>
        <item>好きだった先生の名字は？</item>
        <item>高校を卒業した街は？</item>
        <item>初めての車のメーカーは？</item>
        <item>子どもの頃の親友の名前は？</item>
    </string-array>

