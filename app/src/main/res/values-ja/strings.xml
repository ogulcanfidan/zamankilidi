    <!-- Toasts / dialog text -->
    <string name="toast_find_open_app">次の画面で「Paydos」を探して開いてください</string>
    <string name="device_admin_explanation">ロック中に Paydos を簡単に削除できないようにするために必要です。</string>
    <string name="toast_usage_access_needed">この並べ替えには、Androidの「使用状況へのアクセス」権限が必要です。次の画面のリストで「Paydos」を探して許可してください。</string>
    <string name="usage_access_dialog_title">任意の権限がもう1つ</string>
    <string name="usage_access_dialog_positive">許可</string>
    <string name="usage_access_dialog_negative">今はしない</string>
    <string name="permission_intro_title">Paydos を使うにはいくつかの権限が必要です</string>
    <string name="permission_intro_body">これらがないとロック機能は動作しません：\n\n• ユーザー補助 — どのアプリが開いているかを確認するため\n• デバイス管理者 — ロック中にアプリを削除しにくくするため\n• 通知 — 残り時間をお知らせするため\n\nどの権限も、画面の内容を読み取ったりデータを収集したりすることはありません。</string>
    <string name="permission_intro_button_wait">わかりました（%1$d）</string>
    <string name="permission_intro_button_ready">わかりました、続ける</string>
    <string name="toast_open_permissions_first">先に上の権限をオンにしてください</string>
    <string name="toast_pick_valid_duration">有効な時間を選んでください</string>
    <string name="toast_pin_min_length_new">4桁以上のPINを設定してください</string>
    <string name="toast_pin_min_length_change">新しいPINは4桁以上にしてください</string>
    <string name="toast_lock_started_format">ロックを開始しました：%1$d分</string>

    <!-- Notification -->
    <string name="notification_title_active">Paydos が有効です</string>
    <string name="notification_remaining_format">残り時間：%1$02d:%2$02d</string>
    <string name="notification_channel_name">Paydos タイマー</string>

    <!-- Accessibility permission disclosure screen -->
    <string name="accessibility_disclosure_title">ユーザー補助の権限について</string>
    <string name="accessibility_disclosure_body">Paydos は、ロック中に動作するために Android のユーザー補助の権限を必要とします。続ける前に、この権限の使い道を正確にご説明します：</string>
    <string name="accessibility_disclosure_point_what">🔍 何をするか：ロック中、画面でどのアプリが開いているかを確認します。</string>
    <string name="accessibility_disclosure_point_why">↩️ なぜ必要か：許可されていないアプリが開かれた場合、自動的にロック画面へ戻します。</string>
    <string name="accessibility_disclosure_point_data">🔒 しないこと：画面上の文字やパスワードなどの内容は一切読み取らず、データがスマホの外に出ることもありません。</string>
    <string name="accessibility_disclosure_point_warning">⚠️ ご注意：次の画面で、Android が赤い「危険」の警告を表示することがあります。これはこの権限を求めるすべてのアプリに表示されるシステム標準のメッセージで、Paydos 固有のものではありません。</string>
    <string name="btn_disclosure_continue">了解して続ける</string>
    <string name="btn_disclosure_cancel">今はしない</string>
</resources>
