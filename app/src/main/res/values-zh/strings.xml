    <!-- Accessibility service description (shown in Android Settings) -->
    <string name="accessibility_service_description">让 Paydos 在会话进行期间查看屏幕上正在使用哪个应用，并在打开未允许的应用时返回。它不会读取屏幕内容。</string>

