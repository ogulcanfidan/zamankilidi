    <!-- Accessibility permission disclosure screen -->
    <string name="accessibility_disclosure_title">关于无障碍权限</string>
    <string name="accessibility_disclosure_body">Paydos 需要 Android 的无障碍权限，才能在锁定期间正常工作。继续之前，先说明它的具体用途：</string>
    <string name="accessibility_disclosure_point_what">🔍 它做什么：锁定期间，检查屏幕上打开的是哪个应用。</string>
    <string name="accessibility_disclosure_point_why">↩️ 为什么需要：如果打开了未允许的应用，会自动把你带回锁定页面。</string>
    <string name="accessibility_disclosure_point_data">🔒 它不做什么：不会读取屏幕上的文字、密码或任何其他内容，任何数据都不会离开你的手机。</string>
    <string name="accessibility_disclosure_point_warning">⚠️ 提示：在下一个页面，Android 可能会显示红色的“危险”警告。这是系统对所有申请此权限的应用都会显示的标准提示，并非 Paydos 特有。</string>
    <string name="btn_disclosure_continue">明白了，继续</string>
    <string name="btn_disclosure_cancel">暂不</string>
