    <!-- Accessibility service description (shown in Android Settings) -->
    <string name="accessibility_service_description">세션이 진행되는 동안 Paydos가 화면에 어떤 앱이 열려 있는지 확인하고, 허용되지 않은 앱이 열리면 되돌려 보낼 수 있게 합니다. 화면 내용은 읽지 않습니다.</string>

    <!-- Main screen -->
    <string name="subtitle_main">시간을 정하고, 허용할 앱을 고른 뒤, 아이에게 휴대폰을 건네주세요.</string>

    <string name="permissions_card_title">🔐  먼저 몇 가지 권한이 필요해요</string>
    <string name="permissions_card_body">아래 버튼을 한 번만 누르면 됩니다. 나머지는 순서대로 열어 드리니, 각 화면에서 “허용”/“사용”만 눌러 주세요.</string>
    <string name="btn_grant_permissions">권한 설정하기</string>

    <string name="pin_title_new">🔑  부모 PIN 설정</string>
    <string name="pin_title_saved">🔑  부모 PIN (저장됨)</string>
    <string name="pin_hint_new">4자리 PIN</string>
    <string name="pin_hint_change">변경하려면 새 PIN을 입력하세요</string>
    <string name="pin_card_body">시간이 끝나기 전에 잠금을 해제하려면 이 PIN이 필요합니다. 아이가 모르는 번호로 정하세요.</string>
    <string name="recovery_answer_label">복구 답변 (필수)</string>
    <string name="recovery_answer_hint">PIN을 잊어버리면 이 답변으로 잠금을 해제할 수 있습니다. 본인은 쉽게 기억하지만 아이가 모르거나 짐작할 수 없는 것으로 정하세요. 아이의 출생 연도나 이름은 피하세요. 예: 첫 반려동물의 이름, 가장 좋아했던 선생님의 성, 고등학교를 졸업한 도시.</string>
    <string name="recovery_answer_field_hint">복구 답변 입력</string>
    <string name="recovery_answer_label_saved">복구 답변 (저장됨)</string>
    <string name="recovery_answer_field_hint_saved">새 답변 입력 (선택)</string>
