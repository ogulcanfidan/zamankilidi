    <!-- Accessibility permission disclosure screen -->
    <string name="accessibility_disclosure_title">접근성 권한 안내</string>
    <string name="accessibility_disclosure_body">Paydos는 잠금 세션이 진행되는 동안 작동하기 위해 Android의 접근성 권한이 필요합니다. 계속하기 전에, 이 권한이 정확히 무엇에 쓰이는지 알려 드립니다:</string>
    <string name="accessibility_disclosure_point_what">🔍 하는 일: 잠금이 켜져 있는 동안 화면에 어떤 앱이 열려 있는지 확인합니다.</string>
    <string name="accessibility_disclosure_point_why">↩️ 필요한 이유: 허용되지 않은 앱이 열리면 자동으로 잠금 화면으로 되돌려 보냅니다.</string>
    <string name="accessibility_disclosure_point_data">🔒 하지 않는 일: 화면의 글자, 비밀번호 등 어떤 내용도 읽지 않으며, 어떤 데이터도 휴대폰 밖으로 나가지 않습니다.</string>
    <string name="accessibility_disclosure_point_warning">⚠️ 참고: 다음 화면에서 Android가 빨간색 “위험” 경고를 표시할 수 있습니다. 이는 이 권한을 요청하는 모든 앱에 표시되는 표준 시스템 메시지이며, Paydos에만 해당하는 것이 아닙니다.</string>
    <string name="btn_disclosure_continue">이해했어요, 계속</string>
    <string name="btn_disclosure_cancel">나중에</string>
</resources>
